{
  "expo": {
    "name": "Classroom Feed",
    "slug": "classroom-feed",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "classroomfeed",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.solyapps.classroomfeed",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Homework zip",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive",
              "com.pkware.zip-archive"
            ]
          },
          {
            "CFBundleTypeName": "Finished work",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf",
              "public.image",
              "public.plain-text",
              "public.rtf",
              "org.openxmlformats.wordprocessingml.document",
              "com.microsoft.word.doc",
              "public.data"
            ]
          }
        ]
      }
    },
    "web": {
      "output": "single",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font"
    ],
    "splash": {
      "backgroundColor": "#FFFFFF",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "owner": "solomonsasson",
    "extra": {
      "eas": {
        "projectId": "703d363b-b587-4b9f-9dbf-3a01ee922f53"
      }
    }
  }
}
