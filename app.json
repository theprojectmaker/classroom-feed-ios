{
  "expo": {
    "name": "Classroom Feed",
    "slug": "classroom-feed",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "classroomfeed",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.solyapps.classroomfeed",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Homework zip",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive",
              "com.pkware.zip-archive"
            ]
          },
          {
            "CFBundleTypeName": "Finished work",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf",
              "public.image",
              "public.plain-text",
              "public.rtf",
              "org.openxmlformats.wordprocessingml.document",
              "com.microsoft.word.doc",
              "public.data"
            ]
          }
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "web": {
      "output": "single",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Classroom Feed uses the camera so you can photograph finished work and attach it to an assignment.",
          "photosPermission": "Classroom Feed lets you choose photos of finished work to attach to an assignment.",
          "microphonePermission": false
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#1F5FEE",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "owner": "solomonsasson",
    "extra": {
      "eas": {
        "projectId": "703d363b-b587-4b9f-9dbf-3a01ee922f53"
      }
    },
    "runtimeVersion": "shell-2",
    "updates": {
      "url": "https://u.expo.dev/703d363b-b587-4b9f-9dbf-3a01ee922f53",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
